    <!-- Critical CSS for immediate rendering -->
    <style>
        /* Basic styles to prevent FOUC */
        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #0f172a;
            color: #f1f5f9;
            line-height: 1.6;
        }
        .loading-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
        }
        .loading-screen.hidden {
            opacity: 0;
            visibility: hidden;
        }
        /* Ensure content is visible if loading fails */
        body.loaded .loading-screen {
            display: none !important;
        }
        body.loaded > *:not(.loading-screen) {
            opacity: 1 !important;
        }
    </style>
</head>
